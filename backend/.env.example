# Free key: https://aistudio.google.com/apikey
# Used for document/query embeddings (text-embedding-004)
GOOGLE_API_KEY=your_api_key_here

# Get your free key from https://console.groq.com/keys
GROQ_API_KEY=your_api_key_here

# Model used for answering questions
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated frontend origin(s) allowed to call the API (CORS).
# In production set this to your deployed frontend URL, e.g.
# FRONTEND_URL=https://docqa-rag-two.vercel.app
FRONTEND_URL=http://localhost:5173

# Where Chroma stores its persistent vector data
CHROMA_DIR=./chroma_data
